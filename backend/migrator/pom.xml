<?xml version="1.0" encoding="UTF-8"?>
<!--
  arrheniq-migrator: eSTAR → ArrheniQ migration CLI (docs/data/migration-design.md).
  Plain Java for now; it reuses arrheniq-app services via TargetWriter in Phase 6 (epic E16).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.arrheniq</groupId>
        <artifactId>arrheniq-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>arrheniq-migrator</artifactId>
    <name>ArrheniQ eSTAR migrator</name>

    <dependencies>
        <!-- Oracle JDBC driver for reading the restored eSTAR database (runtime only) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>arrheniq-migrator</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.arrheniq.migrator.MigratorMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
